{
  "name": "larizinhastore",
  "version": "1.0.0",
  "description": "Bot de loja digital no Telegram com painel administrativo, Pix automático, entrega por email/WhatsApp e muito mais.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": ["telegram", "bot", "store", "pix", "mercadopago"],
  "author": "Larizinha Store",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3",
    "axios": "^1.7.4",
    "nodemailer": "^6.9.14",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "prisma": "^5.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
