# Telegram
BOT_TOKEN=seu_token_do_bot

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token_do_mercado_pago
MP_PUBLIC_KEY=sua_public_key
MP_WEBHOOK_SECRET=segredo_para_webhook

# E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha
SMTP_FROM="Larizinha Store <no-reply@larizinhastore.com>"

# Web (para ativação, saque, etc.)
WEB_URL=https://seu-app.render.com
WEB_SECRET=segredo_para_web

# Outras configurações
REDIS_URL=redis://... (opcional para rate limiting/sessões)
