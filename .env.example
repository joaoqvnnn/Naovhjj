# Telegram
BOT_TOKEN=seu_token_do_bot
SUPPORT_BOT_TOKEN=token_do_bot_de_suporte_opcional
OWNER_TELEGRAM_ID=seu_id_do_dono

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token
MP_PUBLIC_KEY=sua_public_key
MP_WEBHOOK_SECRET=segredo_para_webhook

# E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha
SMTP_FROM="Larizinha Store <no-reply@larizinhastore.com>"

# Web
WEB_URL=https://seu-app.render.com
WEB_SECRET=segredo_para_web

# OpenAI
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL=gpt-4o-mini

# WhatsApp API (opcional)
WHATSAPP_API_URL=https://sua-api-whatsapp.com
WHATSAPP_API_KEY=sua_chave
WHATSAPP_INSTANCE=seu_instancia
