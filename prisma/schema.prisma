// Prisma Schema para Larizinha Store
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... (todos os modelos anteriores permanecem iguais) ...

// ==============================
// CÓDIGOS DE RECUPERAÇÃO DE SENHA
// ==============================

model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String   // código hash (não armazenar em texto puro)
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, code])
}
